# Database Configuration
POSTGRES_USER=strava_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=strava_gamification

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Strava OAuth2 Configuration
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_REDIRECT_URI=https://your-domain.com/auth/callback

# Security
SECRET_KEY=change_me_to_a_random_secret_key_in_production

# Backend CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=https://your-domain.com,http://localhost:3000,https://51.159.67.199

# Frontend URL
FRONTEND_URL=https://your-domain.com

# API URL for frontend
NEXT_PUBLIC_API_URL=https://your-domain.com
